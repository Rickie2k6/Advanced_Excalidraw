# Set one or both keys in backend/.env. Leave unused keys empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=  # Alternative name for ANTHROPIC_API_KEY
OPENAI_MODEL=gpt-4.1
CLAUDE_MODEL=claude-sonnet-4-6
# When both keys are set, try this provider first, then the other on failure.
LLM_PROVIDER=openai
